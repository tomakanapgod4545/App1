           if(ride){rideTick(tx);}
           for(const s of sts){let v=Math.floor((T-s.off)/4)*4+s.off;if(v<T-.0001)v+=4;const x="次の電車　"+("0"+Math.floor(v)%24).slice(-2)+"時"+("0"+Math.round(v%1*60)).slice(-2)+"分 到着|普通　"+s.dir;if(x!=s.last){s.last=x;s.d(x.split("|"))}}
           cur=null;let bd=9;for(const o of acts){const d=Math.hypot(o.x-P.position.x,o.z-P.position.z);if(d<o.r&&d<bd&&(o.x>200&&o.x<400&&Math.abs(o.z)<8&&!o.out)===inRoom&&(!o.c||o.c())){bd=d;cur=o}}
           const ab=$("#act");ab.style.display=cur&&!dlg&&!busy?"block":dlg?"block":"none";ab.textContent=dlg?"つづける":cur?cur.l:"";
           const pp=pg.attributes.position.array;for(let i=0;i<N;i++){pp[i*3+1]-=dt*(.6+i%5*.12);pp[i*3]+=Math.sin(clk.elapsedTime+i)*dt*.4;if(pp[i*3+1]<0){pp[i*3+1]=12;pp[i*3]=P.position.x+(Math.random()-.5)*40;pp[i*3+2]=P.position.z+(Math.random()-.5)*40}}pg.attributes.position.needsUpdate=true;pts.visible=!inRoom&&P.position.x<150;
           const cd=inRoom?4.5:6.5,cp=Math.cos(pit);cam.position.set(P.position.x+Math.sin(yaw)*cd*cp,Math.max(.4,2.2+Math.sin(pit)*cd),P.position.z+Math.cos(yaw)*cd*cp);
           if(inRoom){cam.position.x=Math.max(cr-3.6,Math.min(cr+3.6,cam.position.x));cam.position.z=Math.min(3.7,cam.position.z)}
           P.visible=!(fp||ride);if(fp||ride){const hy=P.position.y+1.7;cam.position.set(P.position.x,hy,P.position.z);cam.lookAt(P.position.x-Math.sin(yaw)*Math.cos(pit),hy-Math.sin(pit),P.position.z-Math.cos(yaw)*Math.cos(pit))}else cam.lookAt(P.position.x,1.3,P.position.z);
           if(hold&&bag[hold]){held.visible=true;held.material.color.set(items[hold].c);const par=(fp||ride)?cam:P;if(held.parent!==par)par.add(held);(fp||ride)?held.position.set(.3,-.28,-.6):held.position.set(.4,1,-.35)}else held.visible=false;
           if(sv>8){addH(1);sv=0}
           extra();R.render(S,cam)}
          setInterval(()=>{try{localStorage.setItem("shiawase",JSON.stringify({H,T,bag,m:money}))}catch(e){}},5000);
          loop();
          </script></body></html>

          GAME_EOF
      - run: npm install
      - run: cp node_modules/three/build/three.min.js www/three.min.js
      - run: npx cap add ios
      - name: Hide status bar
        run: |
          PLIST=ios/App/App/Info.plist
          /usr/libexec/PlistBuddy -c "Add :UIStatusBarHidden bool true" $PLIST || true
          /usr/libexec/PlistBuddy -c "Add :UIViewControllerBasedStatusBarAppearance bool false" $PLIST || true
      - run: npx cap sync ios
      - name: Build unsigned archive
        run: |
          xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' -archivePath "$PWD/build/App.xcarchive" CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" archive
      - name: Package IPA
        run: |
          mkdir -p Payload
          cp -R build/App.xcarchive/Products/Applications/App.app Payload/
          zip -qry shiawase-unsigned.ipa Payload
      - uses: actions/upload-artifact@v4
        with:
          name: shiawase-ipa
          path: shiawase-unsigned.ipa
