name: Build IPA
on:
  workflow_dispatch:
  push:
    branches: [main]
jobs:
  build:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Create project files
        run: |
          mkdir -p www
          rm -f www/index.html
          cat > package.json <<'PKG_EOF'
          {"name":"shiawase","version":"1.0.0","private":true,"dependencies":{"@capacitor/cli":"^6.1.2","@capacitor/core":"^6.1.2","@capacitor/ios":"^6.1.2","three":"0.128.0"}}
          PKG_EOF
          cat > capacitor.config.json <<'CAP_EOF'
          {"appId":"com.example.shiawase","appName":"しあわせの散歩道","webDir":"www","backgroundColor":"#000000","ios":{"contentInset":"never","allowsLinkPreview":false}}
          CAP_EOF
      - name: Write game part 1
        run: |
          cat >> www/index.html <<'GAME_EOF'
          <!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>しあわせの散歩道</title>
          <style>
          html,body{margin:0;height:100%;overflow:hidden;background:#000;font-family:"Hiragino Sans","Yu Gothic",sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
          canvas{display:block}
          #hud{position:fixed;left:0;right:0;top:0;padding:calc(env(safe-area-inset-top,0px) + 10px) 14px 0;display:flex;justify-content:space-between;color:#fff;text-shadow:0 1px 4px #0008;font-size:14px;pointer-events:none}
          #bar{width:120px;height:8px;border-radius:4px;background:#fff4;margin-top:5px;overflow:hidden}#bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ffb3c7,#ffd98a);transition:width .8s}
          #dlg{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 22px);transform:translateX(-50%);width:min(560px,92vw);background:#fff7f0ee;color:#4a3a38;border-radius:16px;padding:14px 18px;font-size:16px;line-height:1.6;display:none;box-shadow:0 6px 24px #0005}
          #dlg b{display:block;color:#d4688a;font-size:13px;margin-bottom:2px}
          #act{position:fixed;right:20px;bottom:calc(env(safe-area-inset-bottom,0px) + 36px);padding:14px 22px;border-radius:30px;border:0;background:#ffe3ecf0;color:#a8446a;font-size:16px;display:none;box-shadow:0 4px 14px #0004}
          #stick{position:fixed;left:24px;bottom:calc(env(safe-area-inset-bottom,0px) + 30px);width:120px;height:120px;border-radius:60px;background:#fff3;display:none}
          #knob{position:absolute;left:40px;top:40px;width:40px;height:40px;border-radius:20px;background:#fffb}
          #fade{position:fixed;inset:0;background:#0a0a1c;opacity:0;pointer-events:none;transition:opacity 1.8s;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;letter-spacing:.2em}
          #flash{position:fixed;left:0;right:0;top:35%;text-align:center;color:#fff;font-size:22px;text-shadow:0 2px 12px #d4688a;opacity:0;transition:opacity 1.5s;pointer-events:none;padding:0 20px}
          #tv{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:#000a}
          #tv div{width:min(520px,88vw);height:min(320px,50vh);border:10px solid #333;border-radius:14px;background:linear-gradient(135deg,#ffd0a8,#ffb3c7,#b9d4ff,#ffd0a8);background-size:300% 300%;animation:g 6s infinite alternate;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;box-sizing:border-box;font-size:20px;color:#5a3a4a;line-height:1.7}
          @keyframes g{to{background-position:100% 100%}}
          #title{position:fixed;inset:0;background:linear-gradient(#ffd7c2,#ffb3c7);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#7a3a52;text-align:center;gap:14px;z-index:9}
          #title h1{margin:0;font-weight:400;letter-spacing:.15em}#title button{padding:14px 34px;border:0;border-radius:30px;background:#fff;color:#c4587a;font-size:18px}
          #title p{margin:0;font-size:13px;opacity:.8;line-height:1.7}
          body::after{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 62%,rgba(70,20,50,.3) 100%)}body{-webkit-touch-callout:none;overscroll-behavior:none}</style></head><body>
          <div id="title"><h1>しあわせの散歩道</h1><p>夕焼けの桜町を、ただ歩く。<br>誰かと話して、家で眠って、テレビを見て。<br>急がなくていい一日です。</p><button id="go">はじまり</button><p>移動: WASD / 矢印・スマホは左のスティック<br>視点: ドラッグ　決定: Eキー / ボタン</p></div>
          <div id="hud"><div id="clock"></div><div>しあわせ<div id="bar"><i></i></div></div></div>
          <button id="vb" style="position:fixed;right:14px;top:calc(env(safe-area-inset-top,0px) + 50px);padding:8px 14px;border:0;border-radius:20px;background:#fff9;color:#a8446a">視点 V</button><button id="ib" style="position:fixed;right:14px;top:calc(env(safe-area-inset-top,0px) + 92px);padding:8px 14px;border:0;border-radius:20px;background:#fff9;color:#a8446a">持ち物 Tab</button><div id="dlg"></div><button id="act"></button><div id="stick"><div id="knob"></div></div>
          <div id="fade"></div><div id="flash"></div><div id="tv"><div></div></div>
          <script src="three.min.js"></script>
          <script>
          const $=s=>document.querySelector(s);
          let H=0,T=17,save={};
          try{save=JSON.parse(localStorage.getItem("shiawase")||"{}");H=save.H||0;T=save.T||17}catch(e){}
          const S=new THREE.Scene(),R=new THREE.WebGLRenderer({antialias:true});
          R.setPixelRatio(Math.min(devicePixelRatio,2));R.setSize(innerWidth,innerHeight);document.body.prepend(R.domElement);
          const cam=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,.1,900);
          addEventListener("resize",()=>{R.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()});
          const hemi=new THREE.HemisphereLight(0xfff0e0,0x88aa77,.9),sun=new THREE.DirectionalLight(0xffc89a,.8);sun.position.set(-30,25,20);S.add(hemi,sun);
          const M=c=>new THREE.MeshLambertMaterial({color:c}),solids=[],acts=[];
          function B(w,h,d,c,x,y,z,solid){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),M(c));m.position.set(x,y,z);S.add(m);if(solid)solids.push({x,z,hw:w/2,hd:d/2});return m}
          const g=new THREE.Mesh(new THREE.PlaneGeometry(9000,1200),M(0x8fc47a));g.rotation.x=-Math.PI/2;S.add(g);
          B(60,.05,4,0xeadbb8,0,.03,0);B(4,.05,60,0xeadbb8,0,.04,0);
          function house(x,z,w,d,wc,rc,door){B(w,3.4,d,wc,x,1.7,z,1);const r=new THREE.Mesh(new THREE.ConeGeometry(Math.max(w,d)*.78,2.2,4),M(rc));r.rotation.y=Math.PI/4;r.position.set(x,4.5,z);S.add(r);
           for(const s of[-1,1])B(1,1,.1,0xffe9a0,x+s*w*.25,2,z+d/2+.06).material=new THREE.MeshBasicMaterial({color:0xffe08a});
           if(door){B(1.2,2.2,.15,0x8a5a3c,x,1.1,z+d/2+.08);acts.push({x,z:z+d/2+1,r:1.8,l:"家に入る",f:()=>enter(true)})}}
          house(-12,-10,6,5,0xf6e6d0,0xc96a5a,1);house(12,-10,6,5,0xdfeaf2,0x6a8ab0);house(-12,10,6,5,0xf3dede,0x8a6a9a);house(13,11,7,5,0xf8eec8,0xb0644a);house(22,-2,5,5,0xe3f0dc,0x7a9a6a);
          for(let i=0;i<26;i++){const a=i*2.4,x=(i<13?-1:1)*(4+(i*7%20)),z=-26+i*2.1%52;if(Math.abs(x)<3||Math.abs(z)<3)continue;if(solids.some(s=>Math.abs(x-s.x)<s.hw+3&&Math.abs(z-s.z)<s.hd+3))continue;
           B(.5,2.2,.5,0x7a5a48,x,1.1,z,1);const c=new THREE.Mesh(new THREE.SphereGeometry(2,10,8),M(0xffc6d6));c.position.set(x,3.6,z);c.scale.y=.8;S.add(c)}
          for(const x of[-8,8])for(const z of[-3,3]){B(.15,3,.15,0x444444,x,1.5,z);const l=B(.5,.5,.5,0xffe9a0,x,3.2,z);l.material=new THREE.MeshBasicMaterial({color:0xffe9a0})}
          B(2,.5,.7,0x9a6a4a,6,.45,4.5,1);B(2,.5,.2,0x9a6a4a,6,.9,4.85);acts.push({x:6,z:3.4,r:1.8,l:"ベンチに座る",f:()=>{H=Math.min(100,H+6);say(null,["ベンチに腰かけた。\n風が少しあたたかくて、桜の花びらがひとつ膝にのった。"])}});
          /* room */
          const RX=300;B(8,.1,8,0xd9b88f,RX,.05,0);B(8,.1,8,0xfff4e6,RX,5,0);
          B(8,5,.2,0xfdebdc,RX,2.5,-4);B(.2,5,8,0xfdebdc,RX-4,2.5,0);B(.2,5,8,0xfdebdc,RX+4,2.5,0);B(8,5,.2,0xfdebdc,RX,2.5,4);
          B(2.6,.6,3.4,0xf3c6d0,RX-2.6,.4,-2.2,1);B(2.6,.3,.5,0xffffff,RX-2.6,.85,-3.4);
          const tv=B(2.2,1.3,.2,0x222,RX+1.5,1.4,-3.8);B(2,1.1,.05,0xffc0a0,RX+1.5,1.4,-3.68).material=new THREE.MeshBasicMaterial({color:0xffc9a8});B(2.6,.7,.8,0x555,RX+1.5,.35,-3.6,1);
          B(3,.6,1,0x9ab8d8,RX+1.5,.4,-.6,1);B(3,.6,.4,0x88a6c6,RX+1.5,.9,-.05);
          const win=B(.1,1.6,2.2,0xffd9a0,RX+3.9,2.6,.5);win.material=new THREE.MeshBasicMaterial({color:0xffb27a});
          const rl=new THREE.PointLight(0xffd7a8,1.2,16);rl.position.set(RX,3.6,0);S.add(rl);
          acts.push({x:RX-2.6,z:-.4,r:2.2,l:"ベッドで眠る",f:sleep},{x:RX+1.5,z:-2,r:2,l:"テレビを見る",f:watch},{x:RX+1.5,z:.6,r:1.8,l:"ソファでくつろぐ",f:()=>{H=Math.min(100,H+6);say(null,["ソファに沈みこむ。\n何もしない時間って、こんなにやさしかったんだ。"])}},{x:RX+3,z:.5,r:1.6,l:"窓の外を見る",f:()=>say(null,["窓の外は、空いっぱいの夕焼け。\n今日もちゃんと、一日が終わっていく。"])},{x:RX,z:3.2,r:1.6,l:"外に出る",f:()=>enter(false)});
          /* player */
          const P=new THREE.Group();B(.7,1,.5,0x6a9ad0,0,.9,0,0);P.add(S.children.pop());
          const hd=new THREE.Mesh(new THREE.SphereGeometry(.32,12,10),M(0xffdcc0));hd.position.y=1.7;P.add(hd);S.add(P);
          P.position.set(-12,0,-6.5);let yaw=0,pit=0,inRoom=false,fp=false;
          function npc(n,x,z,c,lines){const o=new THREE.Group(),b=new THREE.Mesh(new THREE.CylinderGeometry(.35,.4,1.2,10),M(c));b.position.y=.7;const h=new THREE.Mesh(new THREE.SphereGeometry(.32,12,10),M(0xffdcc0));h.position.y=1.65;o.add(b,h);o.position.set(x,0,z);S.add(o);
           const q={o,hx:x,hz:z,tx:x,tz:z,i:0,w:0};npcs.push(q);acts.push({npc:q,r:2.2,l:n+"と話す",get x(){return q.o.position.x},get z(){return q.o.position.z},f(){q.w=4;say(n,[lines[q.i++%lines.length]]);if(n=="おばあちゃん"&&!q.g){q.g=1;give("飴")}}})}
          const npcs=[];
          npc("おばあちゃん",-5,-1,0xc9a0d8,["おや、いい夕方だねぇ。散歩かい？","こういう何でもない日がね、あとで一番あったかく思い出されるんだよ。","ゆっくりお行き。街は逃げやしないから。"]);
          npc("パン屋のお姉さん",1,9,0xf0b87a,["焼きたてのパン、いい匂いでしょう？ 今日は焼き上がりが最高なの。","閉店まで、のんびりしていってね。"]);
          npc("犬の散歩の少年",10,0,0x7ac0a0,["うちの犬、桜の花びら追いかけるのが大好きなんだ！","きれいだよね、ここの夕焼け。毎日見ても飽きないんだ。"]);
          npc("ベンチのおじいさん",5,2.6,0x9a9a9a,["…ああ、散歩かね。座ってゆっくり息をするだけで、いい日になるもんだ。","生きてるだけで、もうけもんさ。ほっほ。"]);
          npc("本を抱えた女の子",-9,4,0xf08aa0,["ねえ、空の色が変わっていくの、ずっと見てたの。","明日もこの景色に会えるって、ちょっと嬉しいよね。"]);
          /* station */
          function ez(t){return t*t*(3-2*t)}
          let ride=false,trx=-999,topen=0,lo=0;const T2=(...a)=>{const m=B(...a);S.remove(m);return m};
          B(4600,.1,3,0x6a665e,2100,.05,-34);for(const s of[-.7,.7])B(4600,.12,.12,0xb0b0b8,2100,.16,-34+s);
          function stn(x,n,off,dir){B(24,.12,3,0xd2d0c8,x,.06,-31.3);B(24,.2,3.4,0x6a7a92,x,3.6,-31.3);for(const d of[-11,11])B(.2,3.4,.2,0x555,x+d,1.9,-31.3);
           const c=document.createElement("canvas");c.width=256;c.height=96;const g2=c.getContext("2d"),t=new THREE.CanvasTexture(c);B(3.2,1.2,.15,0x111111,x,2.7,-30);const p=new THREE.Mesh(new THREE.PlaneGeometry(3,1.05),new THREE.MeshBasicMaterial({map:t}));p.position.set(x,2.7,-29.9);S.add(p);
           return{off,n,dir,last:"",d(l){g2.fillStyle="#101018";g2.fillRect(0,0,256,96);g2.fillStyle="#ffb347";g2.font="19px sans-serif";l.forEach((s,i)=>g2.fillText(s,8,26+i*30));g2.fillText(this.n,8,88);t.needsUpdate=true}}}
          const XS=[0,2000,4000],sts=[stn(0,"駅1 桜町",0,"駅2方面"),stn(2000,"駅2 灯ヶ丘",1.25,"駅3方面"),stn(4000,"駅3 緑ヶ原",2.5,"駅1方面")];
          house(80,-22,6,5,0xe8e0d0,0x7a6a5a);house(92,-20,5,5,0xdfeaf2,0x6a8ab0);house(24,10,5,4,0xffe3ec,0xd06a8a);
          acts.push({x:24,z:12.8,r:2.4,l:"駄菓子屋で買う",f:()=>inv(1)});
          const train=new THREE.Group(),dr2=new THREE.Group();for(const o of[-8,0,8]){train.add(T2(7.4,3,2.6,0xe8ecf0,o,1.9,-34),T2(7.4,.5,2.62,0x3a7ab8,o,1,-34),T2(7,.1,2.4,0x8a7458,o,.45,-34));dr2.add(T2(1.6,2.2,.1,0xffe08a,o,1.5,-32.66))}train.add(dr2);S.add(train);
          XS.forEach((x,i)=>{acts.push({x,z:-30.6,r:3.2,l:"電車に乗る",c:()=>false,f:()=>{}});if(i)acts.push({x,z:-34,r:7,l:"電車を降りる",c:()=>false,f:()=>{}})});
          /* petals */
          const N=300,pa=new Float32Array(N*3);for(let i=0;i<N*3;i++)pa[i]=(Math.random()-.5)*40;
          const pg=new THREE.BufferGeometry();pg.setAttribute("position",new THREE.BufferAttribute(pa,3));
          const pts=new THREE.Points(pg,new THREE.PointsMaterial({color:0xffc2d4,size:.22,transparent:true,opacity:.9}));S.add(pts);
          /* ui */
          let dlg=null,busy=false,cur=null;
          const items={飴:{p:50,c:0xff7aa8,k:"食べる"},お茶:{p:120,c:0x7ab87a,k:"飲む"},パン:{p:150,c:0xd9a066,k:"食べる"},おにぎり:{p:130,c:0xf2f2f2,k:"食べる"}};
          let bag=save.bag||{},money=save.m??1000,hold=null;const held=new THREE.Mesh(new THREE.SphereGeometry(.09,10,8),M(0xffffff));S.add(cam);
          const iv=document.createElement("div");iv.style.cssText="position:fixed;inset:0;background:#0008;display:none;align-items:center;justify-content:center;z-index:5";document.body.append(iv);
          function give(n){bag[n]=(bag[n]||0)+1;flash(n+"を手に入れた")}
          function inv(shop){busy=true;iv.style.display="flex";let h='<div style="background:#fff7f0;color:#4a3a38;border-radius:16px;padding:16px;min-width:260px;max-width:90vw;line-height:2.2"><b>'+(shop?"駄菓子屋":"持ち物")+"</b>　¥"+money+"<br>";let n0=0;for(const n in items){const c=bag[n]||0;if(shop)h+=n+" ¥"+items[n].p+` <button onclick="buy('${n}')">買う</button><br>`;else if(c){n0=1;h+=n+" ×"+c+` <button onclick="hold1('${n}')">持つ</button> <button onclick="eat('${n}')">${items[n].k}</button><br>`}}if(!shop&&!n0)h+="何も持っていない<br>";iv.innerHTML=h+'<button onclick="closeInv()">閉じる</button></div>'}
          function buy(n){if(money>=items[n].p){money-=items[n].p;give(n)}inv(1)}
          function hold1(n){hold=n;inv()}
          function eat(n){bag[n]--;if(!bag[n]){delete bag[n];if(hold==n)hold=null}addH(4);flash(n+(items[n].k=="飲む"?"を飲んだ。おいしい。":"を食べた。おいしい。"));inv()}
          function closeInv(){iv.style.display="none";busy=false}
          $("#vb").onclick=()=>fp=!fp;$("#ib").onclick=()=>{if(!busy&&!dlg)inv()};
          function say(n,l){dlg={n,l,i:0};showd()}
          function showd(){const d=$("#dlg");if(!dlg){d.style.display="none";return}d.style.display="block";d.innerHTML=(dlg.n?"<b>"+dlg.n+"</b>":"")+dlg.l[dlg.i].replace(/\n/g,"<br>")}
          let flashT;function flash(t){const f=$("#flash");f.textContent=t;f.style.opacity=1;clearTimeout(flashT);flashT=setTimeout(()=>f.style.opacity=0,3500)}
          function addH(v){const o=H;H=Math.min(100,H+v);for(const t of[25,50,75,100])if(o<t&&H>=t)flash({25:"空気が、やわらかい。",50:"なんだか、胸があたたかい。",75:"今日は、いい日だな。",100:"あ、生きてるって、こんなに幸せなんだ。"}[t])}
          GAME_EOF
      - name: Write game part 2
        run: |
          cat >> www/index.html <<'GAME_EOF'
          function enter(i){busy=true;const f=$("#fade");f.textContent="";f.style.opacity=1;setTimeout(()=>{inRoom=i;if(i){P.position.set(RX,0,2.4)}else P.position.set(-12,0,-6.3);f.style.opacity=0;busy=false},1800)}
          function sleep(){busy=true;const f=$("#fade");f.style.opacity=1;f.textContent="おやすみなさい…";setTimeout(()=>{T=6.5;addH(10);f.textContent="おはよう。";},2600);setTimeout(()=>{f.style.opacity=0;busy=false;say(null,["やわらかい朝の光。\nぐっすり眠れた。それだけで、世界が少し優しい。"])},4200)}
          const tvl=["ニュースです。今日の桜町は、一日中おだやかな天気でした。","動物番組：子猫が初めて雪を見ました。ぽかんと空を見上げています。","料理番組：「おいしいって言う誰かがいるだけで、ごはんは完成します」","夜のうた：どこかで聞いたことのある、懐かしいメロディが流れています。"];
          function watch(){busy=true;const t=$("#tv");t.style.display="flex";t.firstChild.textContent=tvl[Math.random()*tvl.length|0];addH(5);t.onclick=()=>{t.style.display="none";busy=false}}
          function press(){if(busy)return;if(dlg){if(++dlg.i>=dlg.l.length){dlg=null;addH(3)}showd();return}if(cur)cur.f()}
          $("#act").onclick=press;addEventListener("keydown",e=>{k[e.code]=1;if(e.code=="KeyV")fp=!fp;if(e.code=="Tab"){e.preventDefault();if(!busy&&!dlg)inv()}if(["KeyE","Enter","Space"].includes(e.code))press()});addEventListener("keyup",e=>k[e.code]=0);const k={};
          /* input */
          let jx=0,jz=0,dr=null;const st=$("#stick");
          if("ontouchstart"in window)st.style.display="block";
          st.addEventListener("pointerdown",e=>{st.setPointerCapture(e.pointerId);mv(e)});st.addEventListener("pointermove",e=>{if(e.buttons||e.pointerType=="touch")mv(e)});st.addEventListener("pointerup",()=>{jx=jz=0;$("#knob").style.transform=""});
          function mv(e){const r=st.getBoundingClientRect(),x=(e.clientX-r.left-60)/50,z=(e.clientY-r.top-60)/50,l=Math.hypot(x,z),s=l>1?1/l:1;jx=x*s;jz=z*s;$("#knob").style.transform=`translate(${jx*40}px,${jz*40}px)`}
          R.domElement.addEventListener("pointerdown",e=>dr={x:e.clientX,y:e.clientY});addEventListener("pointerup",()=>dr=null);
          addEventListener("pointermove",e=>{if(dr&&e.target===R.domElement){yaw-=(e.clientX-dr.x)*.006;pit=Math.max(-1.5,Math.min(1.5,pit+(e.clientY-dr.y)*.004));dr={x:e.clientX,y:e.clientY}}});
          /* audio */
          let A;function audio(){if(A)return;A=new(window.AudioContext||window.webkitAudioContext)();const o=A.createGain();o.gain.value=.12;o.connect(A.destination);
