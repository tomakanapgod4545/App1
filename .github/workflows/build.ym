          const HH=[[12,-10,330,0xe6eef8,0xcdb38a,0xa0c0d8,["いらっしゃい。散らかってるけど、ゆっくりしていってね。","二人で選んだこの部屋、夢みたいに幸せなんです。"],"お茶",[0xffdcc0,0xf0a0b0,0x6a6a8a,0x5a3a2a,1]],
          [-12,10,270,0xf4e6f0,0xb8a080,0xd0a0c0,["あら、お客さん？ どうぞ、くつろいでね。","窓からの夕焼けを眺めるのが、私の一番の贅沢。"],"パン",[0xe8c8a8,0xa0c080,0x5a4a3a,0xdddddd,1]],
          [13,11,360,0xfaf0d0,0xc8a878,0xe0c070,["おや、薫の香りがするでしょ。今夜はシチューよ。"],null,[0xffdcc0,0xd0a060,0x4a3a3a,0x3a2a1a,1]],
          [22,-2,240,0xe6f2e0,0xbfa27a,0x8ab080,["こんにちは。この家は狭いけど、空が広いからいいんです。"],null,[0xe8c8a8,0x7a9ab0,0x3a3a4a,0x222222,0]]];
          HH.forEach(([x,z,rx,wc,fc,rg,ls,gf,lk])=>{B(1.2,2.2,.15,0x8a5a3c,x,1.1,z+2.58);acts.push({x,z:z+3.5,r:1.8,l:"家にお邇魔する",f:()=>enter(true,{rx,ex:x,ez:z+3.9})});room(rx,wc,fc,rg,ls,gf,lk)});
          function extra(){const tm=clk.elapsedTime,dt=Math.min(.05,tm-lt);lt=tm;for(const q of npcs){const o=q.o.position,mv=Math.hypot(o.x-(q.px??o.x),o.z-(q.pz??o.z))>.0005;q.px=o.x;q.pz=o.z;walk(q.o,tm,mv)}
           idle.forEach(o=>o.userData.L[0].rotation.x<-1?o.userData.B.position.y=Math.sin(tm*2)*.01:walk(o,tm,0));
           dopen+=((topen?1:0)-dopen)*Math.min(1,dt*2.2);dls.forEach(d=>d.g.position.x=d.x0+d.dir*dopen*.9);
           tl.position.set(train.position.x,3,-34);tl.intensity=train.visible?1.6:0;rl.position.x=cr;
