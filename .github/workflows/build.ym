            if(i&&f==0){B(.2,4,12,wl,cx-4,y0+2,SCz+2);solids.push({x:cx-4,z:SCz+2,hw:.1,hd:6})}else if(i)B(.2,4,12,wl,cx-4,y0+2,SCz+2);
            if(SP[nm])SP[nm](cx,y0);else{B(4,1.3,.08,0x2a4a3a,cx,y0+1.8,SCz+7.8);B(1.4,.75,.7,0x9a7a52,cx,y0+.4,SCz+6.4);for(let j=0;j<4;j++)for(let q=0;q<4;q++){d6.position.set(cx-2.7+q*1.8,y0+.36,SCz+j*1.6);d6.updateMatrix();dk.setMatrixAt(dn,d6.matrix);d6.position.set(cx-2.7+q*1.8,y0+.22,SCz+j*1.6-.6);d6.updateMatrix();cr2.setMatrixAt(dn++,d6.matrix)}}}
            if(f<2)for(const s of[-1,1])for(let k2=0;k2<8;k2++)B(1.8,.5*(k2+1),.4,0xb8aa94,SCx+s*18.8,y0+.25*(k2+1),SCz-7.8+k2*.45)}
           S.add(dk,cr2);B(.6,1.4,6,0x6a7a9a,SCx-8,.7,SCz-7.6);B(.6,1.4,6,0x6a7a9a,SCx+8,.7,SCz-7.6);
           for(const s of[-1,1]){const x=SCx+s*16.6;acts.push({x,z:SCz-4.8,r:1.6,l:"階段で上へ",out:1,c:()=>fl<2&&Math.abs(P.position.x-SCx)<20,f:()=>sfade(()=>fl++)},{x,z:SCz-7.2,r:1.6,l:"階段で下へ",out:1,c:()=>fl>0&&Math.abs(P.position.x-SCx)<20,f:()=>sfade(()=>fl--)})}
           const res=(f,lx,lz,lk,ls)=>{const o=new THREE.Group();o.userData={};o.position.set(SCx+lx,f*FH,SCz+lz);person(o,...lk);S.add(o);idle.push(o);let n=0;acts.push({x:o.position.x,z:o.position.z,r:2.2,l:"話しかける",out:1,c:()=>fl==f,f(){say(ls[0],[ls[1+(n++%(ls.length-1))]])}})};
           res(0,-2,6,[0xffdcc0,0xffffff,0xe8a0a0,0x3a2a2a,1],["保健の先生","どこか痛いところはある？ ないなら、ゆっくり休んでいきなさい。"]);res(0,-1.5,3,[0xe8c8a8,0x5a6a8a,0x3a3a4a,0x222222,0],["職員室の先生","放課後の校舎は、一番心が落ち着くんですよ。"]);
           res(1,-12,2,[0xffdcc0,0xf0d060,0x3a5a8a,0x3a2a1a,0],["生徒","ねぇ、明日は遊園地から遠足だよ！","先生の窓の外を見てるところ、好き。"]);res(1,12,3,[0xffdcc0,0x7a6a9a,0x4a4a5a,0x5a3a2a,1],["司書の先生","本の香りって、落ち着くでしょ。"]);res(2,12,3,[0xe8c8a8,0xffffff,0x4a4a5a,0x222222,0],["理科の先生","実験というのは、世界の秘密をこっそり覛くことです。"]);
           schTick=()=>{const p=P.position,inS=Math.abs(p.x-SCx)<20&&p.z>SCz-8.1&&p.z<SCz+8;if(inS&&!sin){sin=true;pfp=fp;fp=true}if(!inS&&sin){sin=false;fp=pfp;fl=0}if(inS&&!ride&&!drv)p.y=fl*FH;sl.position.set(p.x,p.y+3.2,p.z);sl.intensity=inS?1.4:0}}catch(e){}
          {const ex1=extra;let lt3=0;extra=function(){ex1();const tm=clk.elapsedTime,dt=Math.min(.05,tm-lt3);lt3=tm;wtx.offset.y-=dt*.15;carTick(dt);schTick();nh.h=null;if(!inRoom&&!ride){const p=P.position;for(const h of hs)if(Math.abs(p.x-h.x)<5&&Math.hypot(p.x-h.x,p.z-(h.z+h.d/2+1.2))<2.2){nh.h=h;break}}}}
          /* loop */
          const nc=new THREE.Color(0x1b2250),dc=new THREE.Color(0xa6dcff),uc=new THREE.Color(0xffa98a),sc=new THREE.Color(),clk=new THREE.Clock();let sv=0;
          function loop(){requestAnimationFrame(loop);const dt=Math.min(clk.getDelta(),.05);
           if(!busy)T=(T+dt*.025)%24;
           const a=Math.sin((T-6)/12*Math.PI),day=Math.max(0,Math.min(1,a*2+.3)),dusk=Math.min(1,Math.max(0,1-Math.abs(T-17.6)/1.8)+Math.max(0,1-Math.abs(T-6)/1.3));
           sc.copy(nc).lerp(dc,day).lerp(uc,dusk*.75);S.background=sc;S.fog=new THREE.Fog(sc,80,500);hemi.intensity=.4+.6*day;sun.intensity=.15+.7*day;rl.intensity=inRoom?1.2:0;
           const hh=T|0,mm=(T%1*60)|0;$("#clock").textContent=("0"+hh).slice(-2)+":"+("0"+mm).slice(-2);$("#bar i").style.width=H+"%";
           let ix=(k.KeyD||k.ArrowRight?1:0)-(k.KeyA||k.ArrowLeft?1:0)+jx,iz=(k.KeyS||k.ArrowDown?1:0)-(k.KeyW||k.ArrowUp?1:0)+jz;
           if(busy||dlg)ix=iz=0;const l=Math.hypot(ix,iz);
           if(l>.05){if(l>1){ix/=l;iz/=l}const sp=(k.ShiftLeft||k.ShiftRight||runT)?7:3.2,sn=Math.sin(yaw),cs=Math.cos(yaw);
            P.position.x+=(ix*cs+iz*sn)*sp*dt;P.position.z+=(-ix*sn+iz*cs)*sp*dt;P.rotation.y=Math.atan2(ix*cs+iz*sn,-ix*sn+iz*cs);walk(P,clk.elapsedTime,1);sv+=dt}
           for(const s of solids){const cx=Math.max(s.x-s.hw,Math.min(P.position.x,s.x+s.hw)),cz=Math.max(s.z-s.hd,Math.min(P.position.z,s.z+s.hd)),dx=P.position.x-cx,dz=P.position.z-cz,d=Math.hypot(dx,dz);
            if(d<.45){if(d>.001){P.position.x+=dx/d*(.45-d);P.position.z+=dz/d*(.45-d)}else P.position.z+=.5}}
           if(inRoom){P.position.x=Math.max(cr-3.5,Math.min(cr+3.5,P.position.x));P.position.z=Math.max(-3.5,Math.min(3.5,P.position.z))}else if(!ride){P.position.x=Math.max(-100,Math.min(4300,P.position.x));P.position.z=Math.max(-250,Math.min(250,P.position.z))}
           for(const q of npcs){const p=q.o.position;if(q.w>0){q.w-=dt;continue}if(Math.hypot(p.x-P.position.x,p.z-P.position.z)<3)continue;
            if(Math.hypot(q.tx-p.x,q.tz-p.z)<.2){if(Math.random()<.01){q.tx=q.hx+(Math.random()-.5)*5;q.tz=q.hz+(Math.random()-.5)*5}}else{const a=Math.atan2(q.tx-p.x,q.tz-p.z);p.x+=Math.sin(a)*.8*dt;p.z+=Math.cos(a)*.8*dt;q.o.rotation.y=a}}
           const u=T%4;let tx=-999,op=0;if(u>=3.7)tx=-300+300*ez((u-3.7)/.3);else if(u<.25){tx=0;op=1}else if(u<1.25)tx=2000*ez((u-.25)/1);else if(u<1.5){tx=2000;op=2}else if(u<2.5)tx=2000+2000*ez((u-1.5)/1);else if(u<2.75){tx=4000;op=3}else if(u<3.2)tx=4000+400*ez((u-2.75)/.45);else if(u<3.7)tx=-400+100*((u-3.2)/.5);
